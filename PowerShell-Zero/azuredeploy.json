{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "deployWebServer": {
      "type": "string",
      "defaultValue": "Yes",
      "allowedValues": [
        "Yes",
        "No"
      ],
      "metadata": {
        "description": "Deploy the optional WEB member server (IIS and file shares). Choose No for a two-VM lab."
      }
    },
    "remoteAccessMethod": {
      "type": "string",
      "defaultValue": "PublicIP",
      "allowedValues": [
        "PublicIP",
        "Bastion"
      ],
      "metadata": {
        "description": "Remote access method for CLI. PublicIP assigns a public IP to CLI; Bastion deploys Azure Bastion instead. The choices are mutually exclusive."
      }
    },
    "bastionSku": {
      "type": "string",
      "defaultValue": "Basic",
      "allowedValues": [
        "Developer",
        "Basic",
        "Standard"
      ],
      "metadata": {
        "description": "SKU of the Azure Bastion host. Used only when remoteAccessMethod is Bastion."
      }
    },
    "rdpSourceAddressPrefix": {
      "type": "string",
      "defaultValue": "0.0.0.0/32",
      "metadata": {
        "description": "Source address or CIDR allowed to RDP to CLI when remoteAccessMethod is PublicIP."
      }
    },
    "vNetSecondOctet": {
      "type": "int",
      "defaultValue": 30,
      "minValue": 0,
      "maxValue": 255,
      "metadata": {
        "description": "Second octet for the lab network: 10.<value>.0.0/16."
      }
    },
    "adminUserName": {
      "type": "string",
      "defaultValue": "labadmin",
      "minLength": 1,
      "metadata": {
        "description": "Name of the lab administrator (local admin on every VM and domain admin). 'administrator' is not allowed."
      }
    },
    "adminPassword": {
      "type": "securestring",
      "minLength": 8,
      "metadata": {
        "description": "Must meet the complexity requirements for 'adminPassword' of Microsoft.Compute/virtualMachines."
      }
    },
    "_artifactsLocation": {
      "type": "string",
      "metadata": {
        "description": "The base URI where artifacts required by this template are located. Set automatically by Azure DevTest Labs."
      },
      "defaultValue": "https://github.com/PaulDash/Lab-Environments/tree/master/PowerShell-Zero"
    },
    "_artifactsLocationSasToken": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "The SAS token required to access _artifactsLocation. Set automatically by Azure DevTest Labs."
      }
    }
  },
  "variables": {
    "dtlName": "lab-dtl",
    "labName": "PS",
    "envName": "[substring(resourceGroup().name, length(concat(variables('dtlName'), '-')), sub(lastIndexOf(resourceGroup().name, '-'), length(concat(variables('dtlName'), '-'))))]",
    "namePrefix": "[concat('LAB-', variables('labName'), '-', variables('envName'))]",
    "generalSettings": {
      "vmDCName": "DC",
      "vmCliName": "CLI",
      "vmWebName": "WEB",
      "vmStorageAccountType": "StandardSSD_LRS",
      "domainFQDN": "lab.graydaycafe.com",
      "timeZone": "Central Europe Standard Time",
      "enableAutomaticUpdates": false
    },
    "networkSettings": {
      "vNetName": "[concat(variables('namePrefix'), '-vnet')]",
      "vNetPrefix": "[format('10.{0}.0.0/16', parameters('vNetSecondOctet'))]",
      "vNetSubnet1Name": "GDC-Domain",
      "vNetSubnet1Prefix": "[format('10.{0}.1.0/24', parameters('vNetSecondOctet'))]",
      "bastionSubnetPrefix": "[format('10.{0}.3.0/26', parameters('vNetSecondOctet'))]",
      "nsgName": "[concat(variables('namePrefix'), '-nsg')]",
      "bastionName": "[concat(variables('namePrefix'), '-bastion')]",
      "bastionPublicIPName": "[concat(variables('namePrefix'), '-bastion-pip')]"
    },
    "subnetDomain": [
      {
        "name": "[variables('networkSettings').vNetSubnet1Name]",
        "properties": {
          "addressPrefix": "[variables('networkSettings').vNetSubnet1Prefix]"
        }
      }
    ],
    "subnetBastion": [
      {
        "name": "AzureBastionSubnet",
        "properties": {
          "addressPrefix": "[variables('networkSettings').bastionSubnetPrefix]"
        }
      }
    ],
    "vmDC": {
      "vmImagePublisher": "MicrosoftWindowsServer",
      "vmImageOffer": "WindowsServer",
      "vmImageSKU": "2025-datacenter-core-smalldisk-g2",
      "vmResourceName": "[concat(variables('namePrefix'), '-DC-vm')]",
      "vmOSDiskName": "[concat(variables('namePrefix'), '-DC-osdisk')]",
      "vmSize": "Standard_B2s",
      "vmNicName": "[concat(variables('namePrefix'), '-DC-nic')]",
      "nicPrivateIPAddress": "[format('10.{0}.1.20', parameters('vNetSecondOctet'))]"
    },
    "vmCli": {
      "vmImageVersionId": "/subscriptions/2e86df6f-4e12-4a53-b338-94b019c9d7b0/resourceGroups/INFRA-Deployment-weu-rg/providers/Microsoft.Compute/galleries/Deployment_Images_weu_gal/images/CLI-Win11/versions/0.1.0",
      "vmResourceName": "[concat(variables('namePrefix'), '-CLI-vm')]",
      "vmOSDiskName": "[concat(variables('namePrefix'), '-CLI-osdisk')]",
      "vmSize": "Standard_D2s_v4",
      "vmNicName": "[concat(variables('namePrefix'), '-CLI-nic')]",
      "vmPublicIPName": "[concat(variables('namePrefix'), '-CLI-pip')]",
      "vmPublicIPDnsName": "[toLower(replace(concat(resourceGroup().name, '-cli'), '_', '-'))]"
    },
    "vmWeb": {
      "vmImagePublisher": "MicrosoftWindowsServer",
      "vmImageOffer": "WindowsServer",
      "vmImageSKU": "2025-datacenter-smalldisk-g2",
      "vmResourceName": "[concat(variables('namePrefix'), '-WEB-vm')]",
      "vmOSDiskName": "[concat(variables('namePrefix'), '-WEB-osdisk')]",
      "vmSize": "Standard_B2s",
      "vmNicName": "[concat(variables('namePrefix'), '-WEB-nic')]"
    },
    "deployWeb": "[equals(parameters('deployWebServer'), 'Yes')]",
    "clientPublicIP": "[equals(parameters('remoteAccessMethod'), 'PublicIP')]",
    "deployBastion": "[equals(parameters('remoteAccessMethod'), 'Bastion')]",
    "rdpSourceAddressPrefix": "[if(variables('clientPublicIP'), parameters('rdpSourceAddressPrefix'), variables('networkSettings').bastionSubnetPrefix)]",
    "dscConfigureDCVM": {
      "scriptFileUri": "[concat(parameters('_artifactsLocation'), '/dsc/ConfigureDCVM.zip', parameters('_artifactsLocationSasToken'))]",
      "script": "ConfigureDCVM.ps1",
      "function": "ConfigureDCVM",
      "forceUpdateTag": "1.2"
    },
    "dscConfigureCliVM": {
      "scriptFileUri": "[concat(parameters('_artifactsLocation'), '/dsc/ConfigureCliVM.zip', parameters('_artifactsLocationSasToken'))]",
      "script": "ConfigureCliVM.ps1",
      "function": "ConfigureCliVM",
      "forceUpdateTag": "1.2"
    },
    "dscConfigureWebVM": {
      "scriptFileUri": "[concat(parameters('_artifactsLocation'), '/dsc/ConfigureWebVM.zip', parameters('_artifactsLocationSasToken'))]",
      "script": "ConfigureWebVM.ps1",
      "function": "ConfigureWebVM",
      "forceUpdateTag": "1.3"
    }
  },
  "resources": [
    {
      "apiVersion": "2022-07-01",
      "type": "Microsoft.Network/networkSecurityGroups",
      "name": "[variables('networkSettings').nsgName]",
      "location": "[resourceGroup().location]",
      "tags": {
        "displayName": "[variables('networkSettings').nsgName]"
      },
      "properties": {
        "securityRules": [
          {
            "name": "allow-rdp-rule",
            "properties": {
              "description": "Allow RDP",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "3389",
              "sourceAddressPrefix": "[variables('rdpSourceAddressPrefix')]",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "priority": 100,
              "direction": "Inbound"
            }
          }
        ]
      }
    },
    {
      "name": "[variables('networkSettings').vNetName]",
      "type": "Microsoft.Network/virtualNetworks",
      "location": "[resourceGroup().location]",
      "apiVersion": "2022-07-01",
      "tags": {
        "displayName": "[variables('networkSettings').vNetName]"
      },
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "[variables('networkSettings').vNetPrefix]"
          ]
        },
        "subnets": "[if(variables('deployBastion'), concat(variables('subnetDomain'), variables('subnetBastion')), variables('subnetDomain'))]"
      }
    },
    {
      "condition": "[variables('deployBastion')]",
      "name": "[variables('networkSettings').bastionPublicIPName]",
      "type": "Microsoft.Network/publicIPAddresses",
      "location": "[resourceGroup().location]",
      "apiVersion": "2022-07-01",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "publicIPAllocationMethod": "Static"
      }
    },
    {
      "condition": "[variables('deployBastion')]",
      "name": "[variables('networkSettings').bastionName]",
      "type": "Microsoft.Network/bastionHosts",
      "location": "[resourceGroup().location]",
      "apiVersion": "2022-07-01",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('networkSettings').vNetName)]",
        "[resourceId('Microsoft.Network/publicIPAddresses', variables('networkSettings').bastionPublicIPName)]"
      ],
      "sku": {
        "name": "[parameters('bastionSku')]"
      },
      "properties": {
        "ipConfigurations": [
          {
            "name": "bastionIpConfig",
            "properties": {
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('networkSettings').vNetName, 'AzureBastionSubnet')]"
              },
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', variables('networkSettings').bastionPublicIPName)]"
              }
            }
          }
        ]
      }
    },

    {
      "name": "[variables('vmDC').vmNicName]",
      "type": "Microsoft.Network/networkInterfaces",
      "location": "[resourceGroup().location]",
      "apiVersion": "2022-07-01",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('networkSettings').vNetName)]",
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('networkSettings').nsgName)]"
      ],
      "tags": {
        "displayName": "[variables('vmDC').vmNicName]"
      },
      "properties": {
        "networkSecurityGroup": {
          "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('networkSettings').nsgName)]"
        },
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "privateIPAllocationMethod": "Static",
              "privateIPAddress": "[variables('vmDC').nicPrivateIPAddress]",
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('networkSettings').vNetName, variables('networkSettings').vNetSubnet1Name)]"
              }
            }
          }
        ]
      }
    },
    {
      "name": "[variables('vmDC').vmResourceName]",
      "type": "Microsoft.Compute/virtualMachines",
      "location": "[resourceGroup().location]",
      "apiVersion": "2023-03-01",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', variables('vmDC').vmNicName)]"
      ],
      "tags": {
        "displayName": "[variables('vmDC').vmResourceName]"
      },
      "properties": {
        "hardwareProfile": {
          "vmSize": "[variables('vmDC').vmSize]"
        },
        "securityProfile": {
          "securityType": "TrustedLaunch",
          "uefiSettings": {
            "secureBootEnabled": true,
            "vTpmEnabled": true
          }
        },
        "osProfile": {
          "computerName": "[variables('generalSettings').vmDCName]",
          "adminUsername": "[parameters('adminUserName')]",
          "adminPassword": "[parameters('adminPassword')]",
          "windowsConfiguration": {
            "timeZone": "[variables('generalSettings').timeZone]",
            "enableAutomaticUpdates": "[variables('generalSettings').enableAutomaticUpdates]",
            "provisionVMAgent": true
          }
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "[variables('vmDC').vmImagePublisher]",
            "offer": "[variables('vmDC').vmImageOffer]",
            "sku": "[variables('vmDC').vmImageSKU]",
            "version": "latest"
          },
          "osDisk": {
            "name": "[variables('vmDC').vmOSDiskName]",
            "caching": "ReadWrite",
            "osType": "Windows",
            "createOption": "FromImage",
            "managedDisk": {
              "storageAccountType": "[variables('generalSettings').vmStorageAccountType]"
            }
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('vmDC').vmNicName)]"
            }
          ]
        }
      },
      "resources": [
        {
          "name": "[concat(variables('namePrefix'), '-DC-vmext')]",
          "type": "extensions",
          "location": "[resourceGroup().location]",
          "apiVersion": "2023-03-01",
          "dependsOn": [
            "[resourceId('Microsoft.Compute/virtualMachines', variables('vmDC').vmResourceName)]"
          ],
          "tags": {
            "displayName": "[concat(variables('namePrefix'), '-DC-vmext')]"
          },
          "properties": {
            "publisher": "Microsoft.Powershell",
            "type": "DSC",
            "typeHandlerVersion": "2.9",
            "autoUpgradeMinorVersion": true,
            "forceUpdateTag": "[variables('dscConfigureDCVM').forceUpdateTag]",
            "settings": {
              "wmfVersion": "latest",
              "configuration": {
                "url": "[variables('dscConfigureDCVM').scriptFileUri]",
                "script": "[variables('dscConfigureDCVM').script]",
                "function": "[variables('dscConfigureDCVM').function]"
              },
              "configurationArguments": {
                "DomainFQDN": "[variables('generalSettings').domainFQDN]",
                "PrivateIP": "[variables('vmDC').nicPrivateIPAddress]"
              },
              "privacy": {
                "dataCollection": "enable"
              }
            },
            "protectedSettings": {
              "configurationArguments": {
                "AdminCreds": {
                  "UserName": "[parameters('adminUserName')]",
                  "Password": "[parameters('adminPassword')]"
                }
              }
            }
          }
        }
      ]
    },

    {
      "condition": "[variables('clientPublicIP')]",
      "name": "[variables('vmCli').vmPublicIPName]",
      "type": "Microsoft.Network/publicIPAddresses",
      "location": "[resourceGroup().location]",
      "apiVersion": "2022-07-01",
      "tags": {
        "displayName": "[variables('vmCli').vmPublicIPName]"
      },
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "publicIPAllocationMethod": "Static",
        "dnsSettings": {
          "domainNameLabel": "[variables('vmCli').vmPublicIPDnsName]"
        }
      }
    },
    {
      "name": "[variables('vmCli').vmNicName]",
      "type": "Microsoft.Network/networkInterfaces",
      "location": "[resourceGroup().location]",
      "apiVersion": "2022-07-01",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('networkSettings').vNetName)]",
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('networkSettings').nsgName)]",
        "[resourceId('Microsoft.Network/publicIPAddresses', variables('vmCli').vmPublicIPName)]"
      ],
      "tags": {
        "displayName": "[variables('vmCli').vmNicName]"
      },
      "properties": {
        "networkSecurityGroup": {
          "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('networkSettings').nsgName)]"
        },
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('networkSettings').vNetName, variables('networkSettings').vNetSubnet1Name)]"
              },
              "publicIPAddress": "[if(variables('clientPublicIP'), json(concat('{\"id\": \"', resourceId('Microsoft.Network/publicIPAddresses', variables('vmCli').vmPublicIPName), '\"}')), json('null'))]"
            }
          }
        ]
      }
    },
    {
      "name": "[variables('vmCli').vmResourceName]",
      "type": "Microsoft.Compute/virtualMachines",
      "location": "[resourceGroup().location]",
      "apiVersion": "2023-03-01",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', variables('vmCli').vmNicName)]"
      ],
      "tags": {
        "displayName": "[variables('vmCli').vmResourceName]"
      },
      "properties": {
        "hardwareProfile": {
          "vmSize": "[variables('vmCli').vmSize]"
        },
        "securityProfile": {
          "securityType": "TrustedLaunch",
          "uefiSettings": {
            "secureBootEnabled": true,
            "vTpmEnabled": true
          }
        },
        "osProfile": {
          "computerName": "[variables('generalSettings').vmCliName]",
          "adminUsername": "[parameters('adminUserName')]",
          "adminPassword": "[parameters('adminPassword')]",
          "windowsConfiguration": {
            "timeZone": "[variables('generalSettings').timeZone]",
            "enableAutomaticUpdates": "[variables('generalSettings').enableAutomaticUpdates]",
            "provisionVMAgent": true
          }
        },
        "storageProfile": {
          "diskControllerType": "SCSI",
          "imageReference": {
            "id": "[variables('vmCli').vmImageVersionId]"
          },
          "osDisk": {
            "name": "[variables('vmCli').vmOSDiskName]",
            "caching": "ReadWrite",
            "osType": "Windows",
            "createOption": "FromImage",
            "managedDisk": {
              "storageAccountType": "[variables('generalSettings').vmStorageAccountType]"
            }
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('vmCli').vmNicName)]"
            }
          ]
        }
      }
    },
    {
      "name": "[concat(variables('vmCli').vmResourceName, '/', variables('namePrefix'), '-CLI-vmext')]",
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "location": "[resourceGroup().location]",
      "apiVersion": "2023-03-01",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines/extensions', variables('vmDC').vmResourceName, concat(variables('namePrefix'), '-DC-vmext'))]",
        "[resourceId('Microsoft.Compute/virtualMachines', variables('vmCli').vmResourceName)]"
      ],
      "tags": {
        "displayName": "[concat(variables('vmCli').vmResourceName, '/', variables('namePrefix'), '-CLI-vmext')]"
      },
      "properties": {
        "publisher": "Microsoft.Powershell",
        "type": "DSC",
        "typeHandlerVersion": "2.9",
        "autoUpgradeMinorVersion": true,
        "forceUpdateTag": "[variables('dscConfigureCliVM').forceUpdateTag]",
        "settings": {
          "wmfVersion": "latest",
          "configuration": {
            "url": "[variables('dscConfigureCliVM').scriptFileUri]",
            "script": "[variables('dscConfigureCliVM').script]",
            "function": "[variables('dscConfigureCliVM').function]"
          },
          "configurationArguments": {
            "DNSServer": "[variables('vmDC').nicPrivateIPAddress]",
            "DomainFQDN": "[variables('generalSettings').domainFQDN]"
          },
          "privacy": {
            "dataCollection": "enable"
          }
        },
        "protectedSettings": {
          "configurationArguments": {
            "DomainAdminCreds": {
              "UserName": "[parameters('adminUserName')]",
              "Password": "[parameters('adminPassword')]"
            }
          }
        }
      }
    },

    {
      "condition": "[variables('deployWeb')]",
      "name": "[variables('vmWeb').vmNicName]",
      "type": "Microsoft.Network/networkInterfaces",
      "location": "[resourceGroup().location]",
      "apiVersion": "2022-07-01",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('networkSettings').vNetName)]",
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('networkSettings').nsgName)]"
      ],
      "tags": {
        "displayName": "[variables('vmWeb').vmNicName]"
      },
      "properties": {
        "networkSecurityGroup": {
          "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('networkSettings').nsgName)]"
        },
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('networkSettings').vNetName, variables('networkSettings').vNetSubnet1Name)]"
              }
            }
          }
        ]
      }
    },
    {
      "condition": "[variables('deployWeb')]",
      "name": "[variables('vmWeb').vmResourceName]",
      "type": "Microsoft.Compute/virtualMachines",
      "location": "[resourceGroup().location]",
      "apiVersion": "2023-03-01",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', variables('vmWeb').vmNicName)]"
      ],
      "tags": {
        "displayName": "[variables('vmWeb').vmResourceName]"
      },
      "properties": {
        "hardwareProfile": {
          "vmSize": "[variables('vmWeb').vmSize]"
        },
        "securityProfile": {
          "securityType": "TrustedLaunch",
          "uefiSettings": {
            "secureBootEnabled": true,
            "vTpmEnabled": true
          }
        },
        "osProfile": {
          "computerName": "[variables('generalSettings').vmWebName]",
          "adminUsername": "[parameters('adminUserName')]",
          "adminPassword": "[parameters('adminPassword')]",
          "windowsConfiguration": {
            "timeZone": "[variables('generalSettings').timeZone]",
            "enableAutomaticUpdates": "[variables('generalSettings').enableAutomaticUpdates]",
            "provisionVMAgent": true
          }
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "[variables('vmWeb').vmImagePublisher]",
            "offer": "[variables('vmWeb').vmImageOffer]",
            "sku": "[variables('vmWeb').vmImageSKU]",
            "version": "latest"
          },
          "osDisk": {
            "name": "[variables('vmWeb').vmOSDiskName]",
            "caching": "ReadWrite",
            "osType": "Windows",
            "createOption": "FromImage",
            "managedDisk": {
              "storageAccountType": "[variables('generalSettings').vmStorageAccountType]"
            }
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('vmWeb').vmNicName)]"
            }
          ]
        }
      }
    },
    {
      "condition": "[variables('deployWeb')]",
      "name": "[concat(variables('vmWeb').vmResourceName, '/', variables('namePrefix'), '-WEB-vmext')]",
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "location": "[resourceGroup().location]",
      "apiVersion": "2023-03-01",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines/extensions', variables('vmDC').vmResourceName, concat(variables('namePrefix'), '-DC-vmext'))]",
        "[resourceId('Microsoft.Compute/virtualMachines', variables('vmWeb').vmResourceName)]"
      ],
      "tags": {
        "displayName": "[concat(variables('vmWeb').vmResourceName, '/', variables('namePrefix'), '-WEB-vmext')]"
      },
      "properties": {
        "publisher": "Microsoft.Powershell",
        "type": "DSC",
        "typeHandlerVersion": "2.9",
        "autoUpgradeMinorVersion": true,
        "forceUpdateTag": "[variables('dscConfigureWebVM').forceUpdateTag]",
        "settings": {
          "wmfVersion": "latest",
          "configuration": {
            "url": "[variables('dscConfigureWebVM').scriptFileUri]",
            "script": "[variables('dscConfigureWebVM').script]",
            "function": "[variables('dscConfigureWebVM').function]"
          },
          "configurationArguments": {
            "DNSServer": "[variables('vmDC').nicPrivateIPAddress]",
            "DomainFQDN": "[variables('generalSettings').domainFQDN]"
          },
          "privacy": {
            "dataCollection": "enable"
          }
        },
        "protectedSettings": {
          "configurationArguments": {
            "DomainAdminCreds": {
              "UserName": "[parameters('adminUserName')]",
              "Password": "[parameters('adminPassword')]"
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "EnvironmentLocation": {
      "type": "string",
      "value": "[parameters('_artifactsLocation')]"
    },
    "EnvironmentSAS": {
      "type": "string",
      "value": "[parameters('_artifactsLocationSasToken')]"
    }
  }
}
